#################################
# prepare LAMMPS for simulation #
#################################

# OpenMP package
package omp ${nProc} neigh yes

# real units
units real
# atom style
if "${ellipsoids}==1" then &
   "atom_style hybrid angle ellipsoid" &
else &
   "atom_style hybrid angle sphere"
# periodic boundaries
boundary f f f
# atom map
atom_modify id yes map hash