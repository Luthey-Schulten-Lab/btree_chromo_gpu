# variables describing temperature
variable T equal 310.0 # temperature [K]
variable kBoltz equal 1.98720E-3 # Boltzmann's constant [Kcal/(mol*K)]
variable kBT equal ${kBoltz}*${T} # [Kcal/mol]

# variables describing lengths
variable r_mono equal 17.0 # radius of monomer [A]
variable r_ribo equal 5.9*${r_mono} # radius of ribosome [A]
variable r_sphere equal 118.0*${r_mono} # radius of cell membrane [A]
variable r_bdry equal 2.5*${r_mono} # radius of boundary particles
variable sigma_mono_mono equal 2*${r_mono}
variable sigma_mono_ribo equal ${r_mono}+${r_ribo}
variable sigma_ribo_ribo equal 2*${r_ribo}
variable sigma_mono_bdry equal ${r_mono}+${r_bdry}
variable sigma_ribo_bdry equal ${r_ribo}+${r_bdry}
variable sigma_bdry_bdry equal 2*${r_bdry}
variable cut_WCA equal 2.0^(1.0/6.0)
#variable cut_WCA equal 1.5
variable WCA_mono_mono equal ${cut_WCA}*${sigma_mono_mono}
variable WCA_mono_ribo equal ${cut_WCA}*${sigma_mono_ribo}
variable WCA_ribo_ribo equal ${cut_WCA}*${sigma_ribo_ribo}
variable WCA_mono_bdry equal ${cut_WCA}*${sigma_mono_bdry}
variable WCA_ribo_bdry equal ${cut_WCA}*${sigma_ribo_bdry}
variable WCA_bdry_bdry equal ${cut_WCA}*${sigma_bdry_bdry}

# variables describing masses
variable m_mono equal 6.17647E+3 # mass of monomer [g/mol]
variable m_ribo equal 2.11170E+6 # mass of ribosome [g/mol]
variable m_bdry equal 1.0E+9 # mass of boundary particles [g/mol]
variable m_eT equal 1.0E-3 # mass of orientation particle [g/mol]
variable rho_mono equal ${m_mono}/((4.0/3.0)*PI*${r_mono}^3) # density of monomer [g/(mol*A^3)]
variable rho_ribo equal ${m_ribo}/((4.0/3.0)*PI*${r_ribo}^3) # density of ribosome [g/(mol*A^3)]

# variable describing damping coefficients
# variable eta equal 1.6840E+5 # dynamic viscosity of cytoplasm [Kcal*fs/(mol*A^3)]
variable eta equal 7.4574E+1 # dynamic viscosity of cytoplasm [(g/mol)/(fs*A)]
#variable gamma_t_mono equal 6*PI*${eta}*${r_mono}/${m_mono} # [Kcal*fs/(g*A^2)]
variable gamma_t_mono equal 6*PI*${eta}*${r_mono} # [(g/mol)/fs]
variable gamma_r_mono equal ${gamma_t_mono}*(${r_mono}^2)/3
#variable gamma_t_ribo equal 6*PI*${eta}*${r_ribo}/${m_ribo}  # [Kcal*fs/(g*A^2)]
variable gamma_t_ribo equal 6*PI*${eta}*${r_ribo} # [(g/mol)/fs]
variable gamma_r_ribo equal ${gamma_t_ribo}*(${r_ribo}^2)/3

# variables describing energetic parameters
variable k_stretch equal 4.232E-1 # 1000pN/(2*r_mono) [Kcal/(mol*A^2)]
variable l_equil equal 2.0*${r_mono}
#variable k_bend equal 13.1*${kBT} #  [Kcal/(mol*rad^2)]
variable k_bend equal (1.374E+1)*${kBT} #  [Kcal/mol]
variable k_twist equal (1.344E+1)*${kBT} # [Kcal/mol]
variable k_align equal 2*${k_twist} # [Kcal/mol]
variable epsilon_soft equal 1.0*${kBT} # [Kcal/mol]
variable epsilon_LJ equal 1.0*${kBT} # [Kcal/mol]

print "-----------------"
print "---[ Lengths ]---"
print "-----------------"
print "  r_mono = ${r_mono} [A]"
print "  r_ribo = ${r_ribo} [A]"

print "----------------"
print "---[ Masses ]---"
print "----------------"
print "  m_mono = ${m_mono} [g/mol]"
print "  m_ribo = ${m_ribo} [g/mol]"

print "------------------------------"
print "---[ Damping Coefficients ]---"
print "------------------------------"
print "  eta (dynamic viscosity) = ${eta} [Kcal*fs/(mol*A^3)]"
print "  gamma_t_mono = ${gamma_t_mono} [g/(mol*fs)]"
variable ratio_t_mono equal ${m_mono}/${gamma_t_mono}
print "  m_mono/gamma_t_mono = ${ratio_t_mono} [fs]"
print "  gamma_r_mono = ${gamma_r_mono} [g*A/(mol*fs*rad)]"
print "  gamma_t_ribo = ${gamma_t_ribo} [g/(mol*fs)]"
variable ratio_t_ribo equal ${m_ribo}/${gamma_t_ribo}
print "  m_ribo/gamma_t_ribo = ${ratio_t_ribo} [fs]"
print "  gamma_r_ribo = ${gamma_r_ribo} [g*A/(mol*fs*rad)]"

print "------------------------------"
print "---[ Energetic Parameters ]---"
print "------------------------------"
print "  kBT = ${kBT} [Kcal/mol]"
print "  k_stretch = ${k_stretch} [Kcal/(mol*A^2)]"
print "  k_bend = ${k_bend} [Kcal/mol]"
print "  k_twist = ${k_twist} [Kcal/mol]"
print "  k_align = ${k_align} [Kcal/mol]"
print "  epsilon_soft = ${epsilon_soft} [Kcal/mol]"
print "  epsilon_LJ = ${epsilon_LJ} [Kcal/mol]"

# set the mass
print "----------------------------------"
print "---[ Setting Densities/Masses ]---"
print "----------------------------------"
set type 3*6 density ${m_mono}
set type 2 density ${m_ribo}
set type 1 density ${m_bdry}

# create groups
print "------------------------"
print "---[ Grouping Atoms ]---"
print "------------------------"
group bdry type 1
group ribos type 2
group monos type 3
group oris type 4
group ters type 5
group forks type 6
group DNA union monos oris ters forks
group DNAribos union DNA ribos

# bond potentials
bond_style harmonic/omp
bond_coeff 1 ${k_stretch} ${l_equil}

# angle potentials
angle_style   hybrid polytorsion/omp cosine/omp harmonic/omp
angle_coeff   1 cosine/omp ${k_bend} # primary polymer chain angles
angle_coeff   2 polytorsion/omp ${k_align} ${k_twist} # primary polymer chain twist
angle_coeff   3 harmonic/omp ${k_bend} 120.0 # replication fork angles
angle_coeff   4 polytorsion/omp ${k_align} ${k_twist} # replication fork twist

special_bonds angle yes
