# soft pair potentials

variable epsilon_soft equal 5.0*${kBT} # [Kcal/mol]

print """
 ------------------------------------------
 ---[Soft Pairs, Energetic Parameters  ]---
 ------------------------------------------
  kBT = ${kBT} [Kcal/mol]
  epsilon_soft = ${epsilon_soft} [Kcal/mol]
"""

pair_style soft/omp 2.5
pair_modify shift yes
pair_coeff 3*6 3*6 ${epsilon_soft} ${sigma_mono_mono}
pair_coeff 2 3*6 ${epsilon_soft} ${sigma_mono_ribo}
pair_coeff 2 2 ${epsilon_soft} ${sigma_ribo_ribo}
pair_coeff 1 3*6 ${epsilon_soft} ${sigma_mono_bdry}
pair_coeff 1 2 ${epsilon_soft} ${sigma_ribo_bdry}
pair_coeff 1 1 0.0 ${sigma_bdry_bdry}
