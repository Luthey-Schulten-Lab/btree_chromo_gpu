###
# computes for MSD
###

compute dnaMSD DNA msd com no average no
compute ribosMSD ribos msd com no average no
compute orisMSD oris msd com no average no
compute tersMSD ters msd com no average no
compute forksMSD forks msd com no average no

# printing MSD
fix extra all print ${T_freq_r} """{"timestep": $(step), "dnaMSD": $(c_dnaMSD[4]), "ribosMSD": $(c_ribosMSD[4]), "orisMSD": $(c_orisMSD[4]), "tersMSD": $(c_tersMSD[4]), "forksMSD": $(c_forksMSD[4])}""" title "" file ${output_file}_MSD.json screen no
