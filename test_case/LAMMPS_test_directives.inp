prepare_simulator:log.test
simulator_set_prng_seed:10
simulator_set_nProc:20
simulator_set_DNA_model:/home/ben/Workspace/btree_chromo/LAMMPS_DNA_model/
simulator_set_output_details:/home/ben/Workspace/btree_chromo/test_case/,test_case_static
simulator_set_delta_t:1.0E+5

#read the LAMMPS data file into the simulator
simulator_read_data:/home/ben/Workspace/btree_chromo/test_case/data.test_case

simulator_minimize_soft_harmonic:1000
simulator_minimize_soft_FENE:1000
simulator_minimize_hard_harmonic:1000
simulator_minimize_hard_FENE:1000

simulator_run_hard_harmonic:10000,1000,0,noappend,first

sync_simulator_and_system

write_LAMMPS_data:/home/ben/Workspace/btree_chromo/test_case/data.test_case

sync_simulator_and_system

clear_simulator

set_initial_state

transform:m_cw5000_ccw5000

set_final_state

map_replication

write_LAMMPS_data:/home/ben/Workspace/btree_chromo/test_case/data.test_case

simulator_read_data:/home/ben/Workspace/btree_chromo/test_case/data.test_case

