#set the prng seeds
btree_prng_seed:10
replicator_prng_seed:10

#load an input state from a file and print
input_state:/home/ben/Workspace/btree_chromo/test_case/in_state_LAMMPS_test.txt

#transform the current state and print
transform:m_cw10_ccw10
transform:ml_cw5_ccw10
print

#update the topology and print the system
update_topology
print

#dump the current state
output_state:/home/ben/Workspace/btree_chromo/test_case/out_state_LAMMPS_test.txt

#write a LAMMPS data file
write_LAMMPS_data:/home/ben/Workspace/btree_chromo/test_case/data.test
