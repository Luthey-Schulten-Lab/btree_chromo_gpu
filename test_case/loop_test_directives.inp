#set the prng seeds
btree_prng_seed:10
replicator_prng_seed:10

#create a new chromosome with 1000 units
new_chromo:1000

#load the BD lengths
load_BD_lengths:/home/ben/Workspace/btree_chromo/test_case/in_BD_lengths_LAMMPS_test.txt

#load the monomer coordinates
#load_mono_coords:/home/ben/Data/sc_chains/12mono_testcase_100ribos/x_chain_12mono_testcase_100ribos_rep00001.bin,row
load_mono_coords:/home/ben/Data/sc_chains/1000mono_testcase_100ribos/x_chain_1000mono_testcase_100ribos_rep00001.bin,row
#load_mono_quats:/home/ben/Data/sc_chains/1000mono_testcase_100ribos/x_quat_1000mono_testcase_100ribos_rep00001.bin,row
#load_mono_coords:/home/ben/Data/sc_chains/1chromo_500ribos_200rad/x_chain_1chromo_500ribos_200rad_rep00001.bin,row
#load_mono_quats:/home/ben/Data/sc_chains/1chromo_500ribos_200rad/x_quat_1chromo_500ribos_200rad_rep00001.bin,row

#load the ribosome coordinates
#load_ribo_coords:/home/ben/Data/sc_chains/12mono_testcase_100ribos/x_obst_12mono_testcase_100ribos_rep00001.bin,row
load_ribo_coords:/home/ben/Data/sc_chains/1000mono_testcase_100ribos/x_obst_1000mono_testcase_100ribos_rep00001.bin,row
#load_ribo_coords:/home/ben/Data/sc_chains/1chromo_500ribos_200rad/x_obst_1chromo_500ribos_200rad_rep00001.bin,row

set_initial_state

transform:m_cw100_ccw100

set_final_state

map_replication

write_LAMMPS_data:/home/ben/Workspace/btree_chromo/test_case/data.test_loops

prepare_simulator:log.test
simulator_set_prng_seed:10
simulator_set_nProc:20
simulator_set_DNA_model:/home/ben/Workspace/btree_chromo/LAMMPS_DNA_model/
simulator_set_output_details:/home/ben/Workspace/btree_chromo/test_case/,test_loops
simulator_set_delta_t:1.0E+5

#load the loop parameters
simulator_load_loop_params:/home/ben/Workspace/btree_chromo/test_case/loop_params.txt

#read the LAMMPS data file into the simulator
simulator_read_data:/home/ben/Workspace/btree_chromo/test_case/data.test_loops

simulator_minimize_soft_harmonic:1000
simulator_run_soft_harmonic:20000,1000,0,noappend,first

simulator_minimize_hard_harmonic:1000
simulator_run_hard_harmonic:20000,1000,0,noappend,first

simulator_minimize_hard_FENE:1000
#simulator_run_hard_FENE:50000,1000,1000,noappend,first
simulator_run_loops:10,50000,1000,1000,noappend,first
