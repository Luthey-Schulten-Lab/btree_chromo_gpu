######################
######  README  ######
######################

# PURPOSE: run a simulation of a chromosome undergoing replication

# NOTE 1: comment the ``terminate'' at the top to execute all of the commands

# NOTE 2: change all directories in this file from ``/home/ben/Workspace/'' to the local repository location

# NOTE 3: by default the runs will be skipped

# NOTE 4: change the number of processors to whatever is appropriate

######################
######################
######################


#terminate


#enable/disable the skipping of runs/minimizations for debugging of directive file
switch_skip_runs:F

#set the prng seed
btree_prng_seed:10


#create a new circular chromosome with 5000 monomers
new_chromo:5000


#load the BD lengths
load_BD_lengths:/home/andrew/Desktop/Projects/btree_chromo/examples/simulating_chromosome_with_replication_chunky/BD_lengths.txt


#commands to set up the simulator
prepare_simulator:log.test
switch_ellipsoids:F
simulator_set_prng_seed:10
simulator_set_nProc:8
simulator_set_DNA_model:/home/andrew/Desktop/Projects/btree_chromo/LAMMPS_DNA_model/
simulator_set_delta_t:1.0E+5


#set the directory and file label for the simulation output
simulator_set_output_details:/home/andrew/Desktop/Projects/btree_chromo/examples/simulating_chromosome_with_replication_chunky/,example_ellipsoidsF


#load the monomer coordinates and orientations
load_mono_coords:/home/andrew/Desktop/Projects/btree_chromo/examples/simulating_chromosome_with_replication_chunky/x_mono_5000mono_50ribo_bdry900A.bin,row
load_mono_quats:/home/andrew/Desktop/Projects/btree_chromo/examples/simulating_chromosome_with_replication_chunky/q_mono_5000mono_50ribo_bdry900A.bin,row


#load the ribosome coordinates and orientations
load_ribo_coords:/home/andrew/Desktop/Projects/btree_chromo/examples/simulating_chromosome_with_replication_chunky/x_ribo_5000mono_50ribo_bdry900A.bin,row
load_ribo_quats:/home/andrew/Desktop/Projects/btree_chromo/examples/simulating_chromosome_with_replication_chunky/q_ribo_5000mono_50ribo_bdry900A.bin,row


#generate a spherical boundary with 900A radius centered at the origin
spherical_bdry:900.0,0.0,0.0,0.0


#write the LAMMPS data file and read it into the simulator
sys_write_sim_read_LAMMPS_data_at_timestep:/home/andrew/Desktop/Projects/btree_chromo/examples/simulating_chromosome_with_replication_chunky/data.example


#relax the structure
simulator_relax_progressive:10000,5000


#run the system
simulator_run_soft_FENE:10000,1000,10000,noappend,first


#sync the state of the simulator with the system (system will be overwritten by simulator coordinates)
sync_simulator_and_system
sys_write_sim_read_LAMMPS_data_at_timestep:/home/andrew/Desktop/Projects/btree_chromo/examples/simulating_chromosome_with_replication_chunky/data.example

#relax the structure
simulator_relax_progressive:10000,10000

#run the system, append the output to the current output file and do not write the initial timestep
simulator_run_soft_FENE:10000,1000,10000,append,nofirst
sync_simulator_and_system

spherical_bdry:1500.0,0.0,0.0,0.0
sys_write_sim_read_LAMMPS_data_at_timestep:/home/andrew/Desktop/Projects/btree_chromo/examples/simulating_chromosome_with_replication_chunky/data.example
simulator_run_soft_FENE:10000,1000,10000,append,nofirst
sync_simulator_and_system

