#set the prng seed
btree_prng_seed:10
replicator_prng_seed:15


#create a new circular chromosome with 1000000 monomers
new_chromo:1000000


#print the current replication state
print


#output the current state
output_state:/home/ben/Workspace/btree_chromo/examples/simulating_replication_kinetics/chromo_state_0.dat


#read the model of the replication kinetics
load_replication_model:/home/ben/Workspace/btree_chromo/examples/simulating_replication_kinetics/rep_model.txt


#replicate for 3600 seconds
replicate:3600.0


#print the current replication state
print


#output the current state
output_state:/home/ben/Workspace/btree_chromo/examples/simulating_replication_kinetics/chromo_state_2.dat