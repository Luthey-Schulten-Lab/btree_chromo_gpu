 ---[ Twistable DNA (stiff), Energetic Parameters ]---
 -----------------------------------------------------
  kBT = 0.616032 [Kcal/mol]
  k_stretch = 0.532899653979239 [Kcal/(mol*A^2)]
  k_bend = 8.15336470588235 [Kcal/mol]
  k_twist = 7.7004 [Kcal/mol]
  k_align = 15.4008 [Kcal/mol]


# bond potentials
bond_style harmonic/omp
bond_coeff 1 ${k_stretch} ${l_equil}
bond_coeff 1 0.532899653979239 ${l_equil}
bond_coeff 1 0.532899653979239 28
