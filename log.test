include /home/andrew/Desktop/Projects/btree_chromo/LAMMPS_DNA_model_chunky//potentials/lmp.loop_bond_hybrid
include ${DNA_model_dir}/potentials/lmp.DNA_loops
include /home/andrew/Desktop/Projects/btree_chromo/LAMMPS_DNA_model_chunky//potentials/lmp.DNA_loops
variable r_loop equal 4.0*${r_mono} # [A]
