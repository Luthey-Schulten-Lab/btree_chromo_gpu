# variables describing energetic parameters
variable l_equil equal 2.0*${r_mono}
variable l_equil equal 2.0*17
variable k_stretch_FENE equal 100*${kBT}/(${sigma_mono_mono}^2) # [Kcal/(mol*A^2)]
variable k_stretch_FENE equal 100*0.616032/(${sigma_mono_mono}^2) 
variable k_stretch_FENE equal 100*0.616032/(34^2) 
variable R0_FENE equal 1.5*${sigma_mono_mono} # [A]
variable R0_FENE equal 1.5*34 
variable epsilon_FENE equal ${kBT} # [Kcal/mol]
variable epsilon_FENE equal 0.616032 
variable sigma_FENE equal ${sigma_mono_mono} # [A]
variable sigma_FENE equal 34 

include ${DNA_model_dir}/potentials/lmp.DNA_bend_twist_align_params
include /home/andrew/Desktop/Projects/btree_chromo/LAMMPS_DNA_model_chunky//potentials/lmp.DNA_bend_twist_align_params
variable k_bend equal ${kBT}*(450.0/(${sigma_mono_mono})) #  [Kcal/mol]
variable k_bend equal 0.616032*(450.0/(${sigma_mono_mono})) 
variable k_bend equal 0.616032*(450.0/(34)) 
variable k_twist equal ${kBT}*(850.0/(2*${sigma_mono_mono})) # [Kcal/mol]
variable k_twist equal 0.616032*(850.0/(2*${sigma_mono_mono})) 
variable k_twist equal 0.616032*(850.0/(2*34)) 
variable k_align equal 2*${k_twist} # [Kcal/mol]
variable k_align equal 2*7.7004 

print """
 -----------------------------------------------------
 ---[ Twistable DNA (FENE), Energetic Parameters  ]---
 -----------------------------------------------------
  kBT = ${kBT} [Kcal/mol]
  k_stretch_FENE = ${k_stretch_FENE} [Kcal/(mol*A^2)]
  R0_FENE = ${R0_FENE} [A]
  epsilon_FENE = ${epsilon_FENE} [Kcal/mol]
  sigma_FENE = ${sigma_FENE} [A]
  k_bend = ${k_bend} [Kcal/mol]
  k_twist = ${k_twist} [Kcal/mol]
  k_align = ${k_align} [Kcal/mol]
"""

 -----------------------------------------------------
 ---[ Twistable DNA (FENE), Energetic Parameters  ]---
 -----------------------------------------------------
  kBT = 0.616032 [Kcal/mol]
  k_stretch_FENE = 0.0532899653979239 [Kcal/(mol*A^2)]
  R0_FENE = 51 [A]
  epsilon_FENE = 0.616032 [Kcal/mol]
  sigma_FENE = 34 [A]
  k_bend = 8.15336470588235 [Kcal/mol]
  k_twist = 7.7004 [Kcal/mol]
  k_align = 15.4008 [Kcal/mol]


# bond potentials
bond_style hybrid fene/omp harmonic/omp
bond_coeff 1 fene/omp ${k_stretch_FENE} ${R0_FENE} ${epsilon_FENE} ${sigma_FENE}
bond_coeff 1 fene/omp 0.0532899653979239 ${R0_FENE} ${epsilon_FENE} ${sigma_FENE}
bond_coeff 1 fene/omp 0.0532899653979239 51 ${epsilon_FENE} ${sigma_FENE}
bond_coeff 1 fene/omp 0.0532899653979239 51 0.616032 ${sigma_FENE}
bond_coeff 1 fene/omp 0.0532899653979239 51 0.616032 34
