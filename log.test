# computes for MSD
###

compute dnaMSD DNA msd com no average no
compute ribosMSD ribos msd com no average no
compute orisMSD oris msd com no average no
compute tersMSD ters msd com no average no
compute forksMSD forks msd com no average no
include ${DNA_model_dir}/dump_subroutines/subroutine.MSD_thermo
include /home/andrew/Desktop/Projects/btree_chromo/LAMMPS_DNA_model_chunky//dump_subroutines/subroutine.MSD_thermo
# set custom thermo style
thermo		${T_freq}
thermo		1000
# thermo_style custom step # epair ebond eangle c_angleE[1] c_angleE[2] c_angleE[3] # c_dnaMSD[4] c_ribosMSD[4]

thermo_style custom step epair ebond eangle c_dnaMSD[4] c_ribosMSD[4]
reset_timestep 600000
variable D_delay equal 610000
include ${DNA_model_dir}/dump_subroutines/subroutine.dump_append_nofirst_lammpstrj
include /home/andrew/Desktop/Projects/btree_chromo/LAMMPS_DNA_model_chunky//dump_subroutines/subroutine.dump_append_nofirst_lammpstrj
# set custom dump style
dump            d_lammpstrj all custom ${D_freq} ${output_file}.lammpstrj id type x y z c_quat[*] c_id_track c_type_track
dump            d_lammpstrj all custom 10000 ${output_file}.lammpstrj id type x y z c_quat[*] c_id_track c_type_track
dump            d_lammpstrj all custom 10000 /home/andrew/Desktop/Projects/btree_chromo/examples/simulating_chromosome_with_replication_chunky/example.lammpstrj id type x y z c_quat[*] c_id_track c_type_track
dump_modify     d_lammpstrj append yes first no delay ${D_delay}
dump_modify     d_lammpstrj append yes first no delay 610000
#dump_modify     dumplammpstrj append yes first no skip v_skip_condition
include ${DNA_model_dir}/run_subroutines/subroutine.run_soft_FENE
include /home/andrew/Desktop/Projects/btree_chromo/LAMMPS_DNA_model_chunky//run_subroutines/subroutine.run_soft_FENE
# include file with description of DNA polymer model with FENE bonds
include ${DNA_model_dir}/potentials/lmp.twistable_DNA_model_FENE_omp
include /home/andrew/Desktop/Projects/btree_chromo/LAMMPS_DNA_model_chunky//potentials/lmp.twistable_DNA_model_FENE_omp
# variables describing energetic parameters
variable l_equil equal 2.0*${r_mono}
variable l_equil equal 2.0*17
variable k_stretch_FENE equal 100*${kBT}/(${sigma_mono_mono}^2) # [Kcal/(mol*A^2)]
variable k_stretch_FENE equal 100*0.616032/(${sigma_mono_mono}^2) 
variable k_stretch_FENE equal 100*0.616032/(34^2) 
variable R0_FENE equal 1.5*${sigma_mono_mono} # [A]
variable R0_FENE equal 1.5*34 
variable epsilon_FENE equal ${kBT} # [Kcal/mol]
variable epsilon_FENE equal 0.616032 
variable sigma_FENE equal ${sigma_mono_mono} # [A]
variable sigma_FENE equal 34 

include ${DNA_model_dir}/potentials/lmp.DNA_bend_twist_align_params
include /home/andrew/Desktop/Projects/btree_chromo/LAMMPS_DNA_model_chunky//potentials/lmp.DNA_bend_twist_align_params
variable k_bend equal ${kBT}*(450.0/(${sigma_mono_mono})) #  [Kcal/mol]
variable k_bend equal 0.616032*(450.0/(${sigma_mono_mono})) 
variable k_bend equal 0.616032*(450.0/(34)) 
variable k_twist equal ${kBT}*(850.0/(2*${sigma_mono_mono})) # [Kcal/mol]
variable k_twist equal 0.616032*(850.0/(2*${sigma_mono_mono})) 
variable k_twist equal 0.616032*(850.0/(2*34)) 
variable k_align equal 2*${k_twist} # [Kcal/mol]
variable k_align equal 2*7.7004 

print """
 -----------------------------------------------------
 ---[ Twistable DNA (FENE), Energetic Parameters  ]---
 -----------------------------------------------------
  kBT = ${kBT} [Kcal/mol]
  k_stretch_FENE = ${k_stretch_FENE} [Kcal/(mol*A^2)]
  R0_FENE = ${R0_FENE} [A]
  epsilon_FENE = ${epsilon_FENE} [Kcal/mol]
  sigma_FENE = ${sigma_FENE} [A]
  k_bend = ${k_bend} [Kcal/mol]
  k_twist = ${k_twist} [Kcal/mol]
  k_align = ${k_align} [Kcal/mol]
"""

 -----------------------------------------------------
 ---[ Twistable DNA (FENE), Energetic Parameters  ]---
 -----------------------------------------------------
  kBT = 0.616032 [Kcal/mol]
  k_stretch_FENE = 0.0532899653979239 [Kcal/(mol*A^2)]
  R0_FENE = 51 [A]
  epsilon_FENE = 0.616032 [Kcal/mol]
  sigma_FENE = 34 [A]
  k_bend = 8.15336470588235 [Kcal/mol]
  k_twist = 7.7004 [Kcal/mol]
  k_align = 15.4008 [Kcal/mol]


# bond potentials
bond_style hybrid fene/omp harmonic/omp
bond_coeff 1 fene/omp ${k_stretch_FENE} ${R0_FENE} ${epsilon_FENE} ${sigma_FENE}
bond_coeff 1 fene/omp 0.0532899653979239 ${R0_FENE} ${epsilon_FENE} ${sigma_FENE}
bond_coeff 1 fene/omp 0.0532899653979239 51 ${epsilon_FENE} ${sigma_FENE}
bond_coeff 1 fene/omp 0.0532899653979239 51 0.616032 ${sigma_FENE}
bond_coeff 1 fene/omp 0.0532899653979239 51 0.616032 34
include ${DNA_model_dir}/potentials/lmp.loop_bond_hybrid
include /home/andrew/Desktop/Projects/btree_chromo/LAMMPS_DNA_model_chunky//potentials/lmp.loop_bond_hybrid
include ${DNA_model_dir}/potentials/lmp.DNA_loops
include /home/andrew/Desktop/Projects/btree_chromo/LAMMPS_DNA_model_chunky//potentials/lmp.DNA_loops
variable r_loop equal 4.0*${r_mono} # [A]
variable r_loop equal 4.0*17 
variable k_loop equal 4.0*${kBT}/(3*50.0/4.0-${sigma_mono_mono})^2 # [(Kcal/mol)/A^2]
variable k_loop equal 4.0*0.616032/(3*50.0/4.0-${sigma_mono_mono})^2 
variable k_loop equal 4.0*0.616032/(3*50.0/4.0-34)^2 

print """
 -------------------------------------
 ---[ Loops, Energetic Parameters ]---
 -------------------------------------
  kBT = ${kBT} [Kcal/mol]
  k_loop = ${k_loop} [Kcal/(mol*A^2)]
  r_loop = ${r_loop} [A]
"""

 -------------------------------------
 ---[ Loops, Energetic Parameters ]---
 -------------------------------------
  kBT = 0.616032 [Kcal/mol]
  k_loop = 0.201153306122449 [Kcal/(mol*A^2)]
  r_loop = 68 [A]

bond_coeff 2 harmonic/omp ${k_loop} ${r_loop}
bond_coeff 2 harmonic/omp 0.201153306122449 ${r_loop}
bond_coeff 2 harmonic/omp 0.201153306122449 68

# angle potentials
angle_style   hybrid polytorsion/omp cosine/omp harmonic/omp
angle_coeff   1 cosine/omp ${k_bend} # primary polymer chain angles
angle_coeff   1 cosine/omp 8.15336470588235 
angle_coeff   2 polytorsion/omp ${k_align} ${k_twist} # primary polymer chain twist
angle_coeff   2 polytorsion/omp 15.4008 ${k_twist} 
angle_coeff   2 polytorsion/omp 15.4008 7.7004 
angle_coeff   3 harmonic/omp ${k_bend} 120.0 # replication fork angles
angle_coeff   3 harmonic/omp 8.15336470588235 120.0 
angle_coeff   4 polytorsion/omp ${k_align} ${k_twist} # replication fork twist
angle_coeff   4 polytorsion/omp 15.4008 ${k_twist} 
angle_coeff   4 polytorsion/omp 15.4008 7.7004 

special_bonds fene angle yes
