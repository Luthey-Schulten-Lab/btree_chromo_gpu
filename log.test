  k_twist = 7.7004 [Kcal/mol]
  k_align = 15.4008 [Kcal/mol]


# bond potentials
bond_style hybrid fene/omp harmonic/omp
bond_coeff 1 fene/omp ${k_stretch_FENE} ${R0_FENE} ${epsilon_FENE} ${sigma_FENE}
