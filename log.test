if "${ellipsoids}==1" then    "fix dnaBD DNA brownian/asphere/omp ${T} ${rng_seed}    gamma_r_eigen ${gamma_r_mono} ${gamma_r_mono} ${gamma_r_mono}    gamma_t_eigen ${gamma_t_mono} ${gamma_t_mono} ${gamma_t_mono}" else    "fix dnaBD DNA brownian/omp ${T} ${rng_seed} gamma_t ${gamma_t_mono}"
