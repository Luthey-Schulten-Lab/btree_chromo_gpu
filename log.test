variable k_loop equal 4.0*${kBT}/(3*50.0/4.0-${sigma_mono_mono})^2 # [(Kcal/mol)/A^2]
variable k_loop equal 4.0*0.616032/(3*50.0/4.0-${sigma_mono_mono})^2 
variable k_loop equal 4.0*0.616032/(3*50.0/4.0-34)^2 

print """
 -------------------------------------
 ---[ Loops, Energetic Parameters ]---
 -------------------------------------
  kBT = ${kBT} [Kcal/mol]
  k_loop = ${k_loop} [Kcal/(mol*A^2)]
  r_loop = ${r_loop} [A]
"""

 -------------------------------------
 ---[ Loops, Energetic Parameters ]---
 -------------------------------------
  kBT = 0.616032 [Kcal/mol]
  k_loop = 0.201153306122449 [Kcal/(mol*A^2)]
  r_loop = 68 [A]

bond_coeff 2 harmonic/omp ${k_loop} ${r_loop}
bond_coeff 2 harmonic/omp 0.201153306122449 ${r_loop}
bond_coeff 2 harmonic/omp 0.201153306122449 68

# angle potentials
angle_style   hybrid polytorsion/omp cosine/omp harmonic/omp
angle_coeff   1 cosine/omp ${k_bend} # primary polymer chain angles
angle_coeff   1 cosine/omp 8.15336470588235 
angle_coeff   2 polytorsion/omp ${k_align} ${k_twist} # primary polymer chain twist
angle_coeff   2 polytorsion/omp 15.4008 ${k_twist} 
angle_coeff   2 polytorsion/omp 15.4008 7.7004 
angle_coeff   3 harmonic/omp ${k_bend} 120.0 # replication fork angles
angle_coeff   3 harmonic/omp 8.15336470588235 120.0 
angle_coeff   4 polytorsion/omp ${k_align} ${k_twist} # replication fork twist
angle_coeff   4 polytorsion/omp 15.4008 ${k_twist} 
angle_coeff   4 polytorsion/omp 15.4008 7.7004 

special_bonds fene angle yes
