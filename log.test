fix dnaBD DNA brownian/omp 310 ${rng_seed} gamma_t ${gamma_t_mono}
fix dnaBD DNA brownian/omp 310 10 gamma_t ${gamma_t_mono}
fix dnaBD DNA brownian/omp 310 10 gamma_t 22570.0435702202

# BD fix for ribosomes
fix ribosBD ribos brownian/omp ${T} ${rng_seed} gamma_t ${gamma_t_ribo}
fix ribosBD ribos brownian/omp 310 ${rng_seed} gamma_t ${gamma_t_ribo}
fix ribosBD ribos brownian/omp 310 10 gamma_t ${gamma_t_ribo}
fix ribosBD ribos brownian/omp 310 10 gamma_t 132764.962177766
timestep ${delta_t}
timestep 100000
run 100000
