variable epsilon_soft equal 1.0*${kBT} # [Kcal/mol]
variable epsilon_soft equal 1.0*0.616032 
variable epsilon_soft_chunky equal 10.0*${kBT} # [Kcal/mol]
variable epsilon_soft_chunky equal 10.0*0.616032 
variable epsilon_LJ equal 1.0*${kBT} # [Kcal/mol]
variable epsilon_LJ equal 1.0*0.616032 
variable epsilon_soft_topo equal 0.1*${kBT} # [Kcal/mol]
variable epsilon_soft_topo equal 0.1*0.616032 
variable D_morse equal 10.0*${kBT} # [Kcal/mol]
variable D_morse equal 10.0*0.616032 
variable a_morse equal 1.0/(0.5*${sigma_mono_mono}) # [1/A]
variable a_morse equal 1.0/(0.5*34) 
variable r_morse equal 1.5*${sigma_mono_bdry} # [A]
variable r_morse equal 1.5*59.5 
variable rcut_morse equal 3.0*${sigma_mono_bdry} # [A]
variable rcut_morse equal 3.0*59.5 
variable epsilon_ori equal 10.0*${kBT}/(${sigma_mono_mono}^2.0) # [(Kcal/mol)/(A^2)]
variable epsilon_ori equal 10.0*0.616032/(${sigma_mono_mono}^2.0) 
variable epsilon_ori equal 10.0*0.616032/(34^2.0) 
variable r_ori_equil equal 1000.0 # [A]

print """
 ------------------------------------------
 ---[Soft Pairs, Energetic Parameters  ]---
 ------------------------------------------
  kBT = ${kBT} [Kcal/mol]
  epsilon_soft = ${epsilon_soft} [Kcal/mol]
  epsilon_LJ = ${epsilon_LJ} [Kcal/mol]
"""

 ------------------------------------------
 ---[Soft Pairs, Energetic Parameters  ]---
 ------------------------------------------
  kBT = 0.616032 [Kcal/mol]
  epsilon_soft = 0.616032 [Kcal/mol]
  epsilon_LJ = 0.616032 [Kcal/mol]


# 1 - bdry
# 2 - ribo
# 3 - DNA monomer
# 4 - Ori
# 5 - Ter
# 6 - Fork
# 7 - Anchor
# 8 - Hinge

variable pair_extra_pots equal ${Ori_bdry_attraction}+${Ori_pair_repulsion}
variable pair_extra_pots equal 0+${Ori_pair_repulsion}
variable pair_extra_pots equal 0+0

variable temp_pstyle string "pair_style hybrid lj/cut/omp 2.5 soft/omp 2.5"

if "${Ori_bdry_attraction}==1" then    "variable temp_pstyle string '${temp_pstyle} morse/omp 2.5'"

if "${Ori_pair_repulsion}==1" then    "variable temp_pstyle string '${temp_pstyle} harmonic/cut/omp'"

print ' PAIR_STYLE: ${temp_pstyle}'
 PAIR_STYLE: pair_style hybrid lj/cut/omp 2.5 soft/omp 2.5

${temp_pstyle}
pair_style hybrid lj/cut/omp 2.5 soft/omp 2.5
pair_modify shift yes

# basic pair potentials

# DNA
pair_coeff 3*8 3*8 soft/omp ${epsilon_soft} ${sigma_mono_mono}
pair_coeff 3*8 3*8 soft/omp 0.616032 ${sigma_mono_mono}
pair_coeff 3*8 3*8 soft/omp 0.616032 34
# ribosomes
pair_coeff 2 3*8 soft/omp ${epsilon_soft} ${sigma_mono_ribo}
pair_coeff 2 3*8 soft/omp 0.616032 ${sigma_mono_ribo}
pair_coeff 2 3*8 soft/omp 0.616032 117
pair_coeff 2 2 soft/omp ${epsilon_soft} ${sigma_ribo_ribo}
pair_coeff 2 2 soft/omp 0.616032 ${sigma_ribo_ribo}
pair_coeff 2 2 soft/omp 0.616032 200
# boundary particles
pair_coeff 1 3*8 lj/cut/omp ${epsilon_LJ} ${sigma_mono_bdry} ${WCA_mono_bdry}
pair_coeff 1 3*8 lj/cut/omp 0.616032 ${sigma_mono_bdry} ${WCA_mono_bdry}
pair_coeff 1 3*8 lj/cut/omp 0.616032 59.5 ${WCA_mono_bdry}
pair_coeff 1 3*8 lj/cut/omp 0.616032 59.5 66.7864918744075
pair_coeff 1 2 lj/cut/omp ${epsilon_LJ} ${sigma_ribo_bdry} ${WCA_ribo_bdry}
pair_coeff 1 2 lj/cut/omp 0.616032 ${sigma_ribo_bdry} ${WCA_ribo_bdry}
pair_coeff 1 2 lj/cut/omp 0.616032 142.5 ${WCA_ribo_bdry}
pair_coeff 1 2 lj/cut/omp 0.616032 142.5 159.950841884085
pair_coeff 1 1 lj/cut/omp 0.0 ${sigma_bdry_bdry} ${WCA_bdry_bdry}
pair_coeff 1 1 lj/cut/omp 0.0 85 ${WCA_bdry_bdry}
pair_coeff 1 1 lj/cut/omp 0.0 85 95.4092741062964

# extra pair potentials

if "${Ori_bdry_attraction}==1" then    "pair_coeff 1 4 morse/omp ${D_morse} ${a_morse} ${r_morse} ${rcut_morse}"

if "${Ori_pair_repulsion}==1" then    "pair_coeff 4 4 harmonic/cut/omp ${epsilon_ori} ${r_ori_equil}"

