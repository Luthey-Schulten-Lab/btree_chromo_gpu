variable rng_seed internal 000010
variable delta_t internal 100000.000000
include ${DNA_model_dir}/protocol_subroutines/subroutine.global_setup
include /home/andrew/Desktop/Projects/btree_chromo/LAMMPS_DNA_model//protocol_subroutines/subroutine.global_setup
#################################
# prepare LAMMPS for simulation #
#################################

# OpenMP package
package omp ${nProc} neigh yes
package omp 8 neigh yes
set 8 OpenMP thread(s) per MPI task
using multi-threaded neighbor list subroutines

# real units
units real
# atom style
atom_style hybrid angle ellipsoid
WARNING: Atom style hybrid defines both, per-type and per-atom masses; both must be set, but only per-atom masses will be used (src/atom_vec_hybrid.cpp:132)
# periodic boundaries
boundary f f f
# atom map
atom_modify id yes map hash
read_data /home/andrew/Desktop/Projects/btree_chromo/examples/simulating_chromosome_with_replication_chunky/data.example_t130000 extra/bond/per/atom 2
Reading data file ...
  orthogonal box = (-1851 -1851 -1851) to (1851 1851 1851)
