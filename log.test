variable kBT equal 0.0019872*${T} 
variable kBT equal 0.0019872*310 

# variables describing lengths
variable r_mono internal 17.0 # radius of monomer [A]
variable r_ribo internal 100.0 # radius of ribosome [A]
variable r_sphere internal 2500.0 # radius of cell membrane [A]
variable r_bdry equal 2.5*${r_mono} # radius of boundary particles
variable r_bdry equal 2.5*17 
variable sigma_mono_mono equal 2*${r_mono}
variable sigma_mono_mono equal 2*17
variable sigma_mono_mono_chunky equal 200.0
variable sigma_mono_ribo equal ${r_mono}+${r_ribo}
variable sigma_mono_ribo equal 17+${r_ribo}
variable sigma_mono_ribo equal 17+100
variable sigma_ribo_ribo equal 2*${r_ribo}
variable sigma_ribo_ribo equal 2*100
variable sigma_mono_bdry equal ${r_mono}+${r_bdry}
variable sigma_mono_bdry equal 17+${r_bdry}
variable sigma_mono_bdry equal 17+42.5
variable sigma_ribo_bdry equal ${r_ribo}+${r_bdry}
variable sigma_ribo_bdry equal 100+${r_bdry}
variable sigma_ribo_bdry equal 100+42.5
variable sigma_bdry_bdry equal 2*${r_bdry}
variable sigma_bdry_bdry equal 2*42.5
variable cut_WCA equal 2.0^(1.0/6.0) # cutoff for WCA potentials
variable WCA_mono_mono equal ${cut_WCA}*${sigma_mono_mono}
variable WCA_mono_mono equal 1.12246204830937*${sigma_mono_mono}
variable WCA_mono_mono equal 1.12246204830937*34
variable WCA_mono_ribo equal ${cut_WCA}*${sigma_mono_ribo}
variable WCA_mono_ribo equal 1.12246204830937*${sigma_mono_ribo}
variable WCA_mono_ribo equal 1.12246204830937*117
variable WCA_ribo_ribo equal ${cut_WCA}*${sigma_ribo_ribo}
variable WCA_ribo_ribo equal 1.12246204830937*${sigma_ribo_ribo}
variable WCA_ribo_ribo equal 1.12246204830937*200
variable WCA_mono_bdry equal ${cut_WCA}*${sigma_mono_bdry}
variable WCA_mono_bdry equal 1.12246204830937*${sigma_mono_bdry}
variable WCA_mono_bdry equal 1.12246204830937*59.5
variable WCA_ribo_bdry equal ${cut_WCA}*${sigma_ribo_bdry}
variable WCA_ribo_bdry equal 1.12246204830937*${sigma_ribo_bdry}
variable WCA_ribo_bdry equal 1.12246204830937*142.5
variable WCA_bdry_bdry equal ${cut_WCA}*${sigma_bdry_bdry}
variable WCA_bdry_bdry equal 1.12246204830937*${sigma_bdry_bdry}
variable WCA_bdry_bdry equal 1.12246204830937*85

# variables describing masses
variable m_mono internal 6.17647E+3 # mass of monomer [g/mol]
variable m_ribo internal 2.11170E+6 # mass of ribosome [g/mol]
