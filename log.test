variable eta internal 7.0434E+1 # dynamic viscosity of cytoplasm [(g/mol)/(fs*A)]
#variable gamma_t_mono equal 6*PI*${eta}*${r_mono}/${m_mono} # [Kcal*fs/(g*A^2)]
variable gamma_t_mono equal 6*PI*${eta}*${r_mono} # [(g/mol)/fs]
variable gamma_t_mono equal 6*PI*70.434*${r_mono} 
variable gamma_t_mono equal 6*PI*70.434*17 
variable gamma_r_mono equal ${gamma_t_mono}*(${sigma_mono_mono}^2)/3
variable gamma_r_mono equal 22570.0435702202*(${sigma_mono_mono}^2)/3
variable gamma_r_mono equal 22570.0435702202*(34^2)/3
#variable gamma_t_ribo equal 6*PI*${eta}*${r_ribo}/${m_ribo}  # [Kcal*fs/(g*A^2)]
variable gamma_t_ribo equal 6*PI*${eta}*${r_ribo} # [(g/mol)/fs]
variable gamma_t_ribo equal 6*PI*70.434*${r_ribo} 
variable gamma_t_ribo equal 6*PI*70.434*100 
variable gamma_r_ribo equal ${gamma_t_ribo}*(${sigma_ribo_ribo}^2)/3
variable gamma_r_ribo equal 132764.962177766*(${sigma_ribo_ribo}^2)/3
variable gamma_r_ribo equal 132764.962177766*(200^2)/3
variable ratio_t_mono equal ${m_mono}/${gamma_t_mono}
variable ratio_t_mono equal 6176.47/${gamma_t_mono}
variable ratio_t_mono equal 6176.47/22570.0435702202
variable ratio_t_ribo equal ${m_ribo}/${gamma_t_ribo}
variable ratio_t_ribo equal 2111700/${gamma_t_ribo}
