variable k_stretch equal 1000*${kBT}/(${sigma_mono_mono}^2) # [Kcal/(mol*A^2)]
variable k_stretch equal 1000*0.616032/(${sigma_mono_mono}^2) 
variable k_stretch equal 1000*0.616032/(34^2) 

include ${DNA_model_dir}/potentials/lmp.DNA_bend_twist_align_params
include /home/andrew/Desktop/Projects/btree_chromo/LAMMPS_DNA_model//potentials/lmp.DNA_bend_twist_align_params
variable k_bend equal ${kBT}*(450.0/(${sigma_mono_mono})) #  [Kcal/mol]
variable k_bend equal 0.616032*(450.0/(${sigma_mono_mono})) 
variable k_bend equal 0.616032*(450.0/(34)) 
variable k_twist equal ${kBT}*(850.0/(2*${sigma_mono_mono})) # [Kcal/mol]
variable k_twist equal 0.616032*(850.0/(2*${sigma_mono_mono})) 
variable k_twist equal 0.616032*(850.0/(2*34)) 
variable k_align equal 2*${k_twist} # [Kcal/mol]
variable k_align equal 2*7.7004 

print """
