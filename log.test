# include file with neighbor setup
include ${DNA_model_dir}/protocol_subroutines/subroutine.neighbor_setup
include /home/andrew/Desktop/Projects/btree_chromo/LAMMPS_DNA_model_chunky//protocol_subroutines/subroutine.neighbor_setup
# 1 - bdry
# 2 - ribo
# 3 - DNA monomer
# 4 - Ori
# 5 - Ter
# 6 - Fork
# 7 - Anchor
# 8 - Hinge

# set the neighbor type
neighbor ${r_ribo} bin
neighbor 100 bin
neigh_modify every 1 delay 5 check yes page 100000 exclude type 1 1

