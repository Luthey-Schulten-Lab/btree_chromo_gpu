# periodic boundaries
boundary f f f
# atom map
atom_modify id yes map hash
read_data /home/andrew/Desktop/Projects/btree_chromo/examples/simulating_chromosome_with_replication_chunky/data.example_t1000000 extra/bond/per/atom 2
