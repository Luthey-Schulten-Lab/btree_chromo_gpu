variable pair_extra_pots equal ${Ori_bdry_attraction}+${Ori_pair_repulsion}
variable pair_extra_pots equal 0+${Ori_pair_repulsion}
variable pair_extra_pots equal 0+0

variable temp_pstyle string "pair_style hybrid lj/cut/omp 2.5 soft/omp 2.5"

if "${Ori_bdry_attraction}==1" then    "variable temp_pstyle string '${temp_pstyle} morse/omp 2.5'"

