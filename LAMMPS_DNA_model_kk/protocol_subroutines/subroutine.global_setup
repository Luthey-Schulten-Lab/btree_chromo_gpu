#################################
# prepare LAMMPS for simulation #
#################################

# OpenMP package
# package omp ${nProc} neigh yes

# Kokkos package (can also do -pk kokkos in LAMMPS_initialize)
# package kokkos neigh full

# real units
units real
# atom style
# atom_style hybrid angle ellipsoid
# atom_style hybrid/kk angle/kk sphere/kk
atom_style angle/kk
# periodic boundaries
boundary f f f
# atom map
atom_modify id yes map hash