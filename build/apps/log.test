variable D_delay equal 125000
include ${DNA_model_dir}/dump_subroutines/subroutine.dump_append_nofirst_lammpstrj
include /home/andrew/Desktop/Projects/btree_chromo/LAMMPS_DNA_model//dump_subroutines/subroutine.dump_append_nofirst_lammpstrj
# set custom dump style
dump            d_lammpstrj all custom ${D_freq} ${output_file}.lammpstrj id type x y z c_quat[*] c_id_track c_type_track
dump            d_lammpstrj all custom 25000 ${output_file}.lammpstrj id type x y z c_quat[*] c_id_track c_type_track
dump            d_lammpstrj all custom 25000 /home/andrew/Data/btree_chromo/cylinder_testing/1_2500_2500_forkpartition_Oripair_loops.lammpstrj id type x y z c_quat[*] c_id_track c_type_track
dump_modify     d_lammpstrj append yes first no delay ${D_delay}
dump_modify     d_lammpstrj append yes first no delay 125000
