# release ribosomes from springs following minimization
unfix ribosSpring
reset_timestep 340000
variable T_freq delete
variable T_freq internal 10000
variable D_freq delete
variable D_freq internal 0
variable Ori_pair_repulsion delete
variable Ori_pair_repulsion internal 1
variable Ori_bdry_attraction delete
variable Ori_bdry_attraction internal 0
uncompute id_track
include ${DNA_model_dir}/compute_subroutines/subroutine.compute_ids
include /home/andrew/Desktop/Projects/btree_chromo/LAMMPS_DNA_model//compute_subroutines/subroutine.compute_ids
# compute to track ids
compute id_track all property/atom id
uncompute type_track
include ${DNA_model_dir}/compute_subroutines/subroutine.compute_types
include /home/andrew/Desktop/Projects/btree_chromo/LAMMPS_DNA_model//compute_subroutines/subroutine.compute_types
# compute to track types
compute type_track all property/atom type
uncompute quat
include ${DNA_model_dir}/compute_subroutines/subroutine.compute_quats
include /home/andrew/Desktop/Projects/btree_chromo/LAMMPS_DNA_model//compute_subroutines/subroutine.compute_quats
# compute to calculate orientations
compute quat DNAribos property/atom quatw quati quatj quatk
uncompute dnaMSD
uncompute ribosMSD
uncompute orisMSD
uncompute tersMSD
uncompute forksMSD
include ${DNA_model_dir}/compute_subroutines/subroutine.compute_MSD
include /home/andrew/Desktop/Projects/btree_chromo/LAMMPS_DNA_model//compute_subroutines/subroutine.compute_MSD
###
# computes for MSD
###

compute dnaMSD DNA msd com no average no
compute ribosMSD ribos msd com no average no
compute orisMSD oris msd com no average no
compute tersMSD ters msd com no average no
compute forksMSD forks msd com no average no
include ${DNA_model_dir}/dump_subroutines/subroutine.MSD_thermo
include /home/andrew/Desktop/Projects/btree_chromo/LAMMPS_DNA_model//dump_subroutines/subroutine.MSD_thermo
# set custom thermo style
thermo		${T_freq}
thermo		10000
# thermo_style custom step # epair ebond eangle c_angleE[1] c_angleE[2] c_angleE[3] # c_dnaMSD[4] c_ribosMSD[4]

thermo_style custom step epair ebond eangle c_dnaMSD[4] c_ribosMSD[4]
