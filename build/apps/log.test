 ---[LJ/cut (WCA) Pairs, Energetic Parameters  ]---
 --------------------------------------------------
  kBT = 0.616032 [Kcal/mol]
  epsilon_LJ = 0.616032 [Kcal/mol]


variable s_expand equal 1.0
variable sigma_mono_mono_ex equal ${s_expand}*${sigma_mono_mono}
variable sigma_mono_mono_ex equal 1*${sigma_mono_mono}
variable sigma_mono_mono_ex equal 1*34
variable WCA_mono_mono_ex equal ${s_expand}*${WCA_mono_mono}
variable WCA_mono_mono_ex equal 1*${WCA_mono_mono}
variable WCA_mono_mono_ex equal 1*38.1637096425186

# 1 - bdry
# 2 - ribo
# 3 - DNA monomer
# 4 - Ori
# 5 - Ter
# 6 - Fork
# 7 - Anchor
# 8 - Hinge

variable pair_extra_pots equal ${Ori_bdry_attraction}+${Ori_pair_repulsion}
variable pair_extra_pots equal 0+${Ori_pair_repulsion}
variable pair_extra_pots equal 0+1

if "${pair_extra_pots}>0" then    "print 'yes extra potentials'"    "variable temp_pstyle string 'pair_style hybrid'"    "variable temp_pstyle string '${temp_pstyle} lj/cut/omp 2.5'" else    "print 'no extra potentials'"    "variable temp_pstyle string 'pair_style lj/cut/omp 2.5'"
print 'yes extra potentials'
yes extra potentials
variable temp_pstyle string 'pair_style hybrid'
variable temp_pstyle string '${temp_pstyle} lj/cut/omp 2.5'
pair_style hybrid lj/cut/omp 2.5

if "${Ori_bdry_attraction}==1" then    "variable temp_pstyle string '${temp_pstyle} morse/omp 2.5'"

if "${Ori_pair_repulsion}==1" then    "variable temp_pstyle string '${temp_pstyle} harmonic/cut/omp'"
variable temp_pstyle string '${temp_pstyle} harmonic/cut/omp'
pair_style hybrid lj/cut/omp 2.5 harmonic/cut/omp

print ' PAIR_STYLE: ${temp_pstyle}'
 PAIR_STYLE: pair_style hybrid lj/cut/omp 2.5 harmonic/cut/omp

${temp_pstyle}
pair_style hybrid lj/cut/omp 2.5 harmonic/cut/omp
pair_modify shift yes

# basic pair potentials

if "${pair_extra_pots}>0" then    "pair_coeff 3*8 3*8 lj/cut/omp ${epsilon_LJ} ${sigma_mono_mono_ex} ${WCA_mono_mono_ex}"    "pair_coeff 2 3*8 lj/cut/omp ${epsilon_LJ} ${sigma_mono_ribo} ${WCA_mono_ribo}"    "pair_coeff 2 2 lj/cut/omp ${epsilon_LJ} ${sigma_ribo_ribo} ${WCA_ribo_ribo}"    "pair_coeff 1 3*8 lj/cut/omp ${epsilon_LJ} ${sigma_mono_bdry} ${WCA_mono_bdry}"    "pair_coeff 1 2 lj/cut/omp ${epsilon_LJ} ${sigma_ribo_bdry} ${WCA_ribo_bdry}"    "pair_coeff 1 1 lj/cut/omp 0.0 ${sigma_bdry_bdry} ${WCA_bdry_bdry}" else    "pair_coeff 3*8 3*8 ${epsilon_LJ} ${sigma_mono_mono_ex} ${WCA_mono_mono_ex}"    "pair_coeff 2 3*8 ${epsilon_LJ} ${sigma_mono_ribo} ${WCA_mono_ribo}"    "pair_coeff 2 2 ${epsilon_LJ} ${sigma_ribo_ribo} ${WCA_ribo_ribo}"    "pair_coeff 1 3*8 ${epsilon_LJ} ${sigma_mono_bdry} ${WCA_mono_bdry}"    "pair_coeff 1 2 ${epsilon_LJ} ${sigma_ribo_bdry} ${WCA_ribo_bdry}"    "pair_coeff 1 1 0.0 ${sigma_bdry_bdry} ${WCA_bdry_bdry}"
pair_coeff 3*8 3*8 lj/cut/omp ${epsilon_LJ} ${sigma_mono_mono_ex} ${WCA_mono_mono_ex}
pair_coeff 3*8 3*8 lj/cut/omp 0.616032 ${sigma_mono_mono_ex} ${WCA_mono_mono_ex}
pair_coeff 3*8 3*8 lj/cut/omp 0.616032 34 ${WCA_mono_mono_ex}
pair_coeff 3*8 3*8 lj/cut/omp 0.616032 34 38.1637096425186
pair_coeff 2 3*8 lj/cut/omp ${epsilon_LJ} ${sigma_mono_ribo} ${WCA_mono_ribo}
pair_coeff 2 3*8 lj/cut/omp 0.616032 ${sigma_mono_ribo} ${WCA_mono_ribo}
pair_coeff 2 3*8 lj/cut/omp 0.616032 117 ${WCA_mono_ribo}
pair_coeff 2 3*8 lj/cut/omp 0.616032 117 131.328059652196
pair_coeff 2 2 lj/cut/omp ${epsilon_LJ} ${sigma_ribo_ribo} ${WCA_ribo_ribo}
pair_coeff 2 2 lj/cut/omp 0.616032 ${sigma_ribo_ribo} ${WCA_ribo_ribo}
pair_coeff 2 2 lj/cut/omp 0.616032 200 ${WCA_ribo_ribo}
pair_coeff 2 2 lj/cut/omp 0.616032 200 224.492409661874
pair_coeff 1 3*8 lj/cut/omp ${epsilon_LJ} ${sigma_mono_bdry} ${WCA_mono_bdry}
pair_coeff 1 3*8 lj/cut/omp 0.616032 ${sigma_mono_bdry} ${WCA_mono_bdry}
pair_coeff 1 3*8 lj/cut/omp 0.616032 59.5 ${WCA_mono_bdry}
pair_coeff 1 3*8 lj/cut/omp 0.616032 59.5 66.7864918744075
pair_coeff 1 2 lj/cut/omp ${epsilon_LJ} ${sigma_ribo_bdry} ${WCA_ribo_bdry}
pair_coeff 1 2 lj/cut/omp 0.616032 ${sigma_ribo_bdry} ${WCA_ribo_bdry}
pair_coeff 1 2 lj/cut/omp 0.616032 142.5 ${WCA_ribo_bdry}
pair_coeff 1 2 lj/cut/omp 0.616032 142.5 159.950841884085
pair_coeff 1 1 lj/cut/omp 0.0 ${sigma_bdry_bdry} ${WCA_bdry_bdry}
pair_coeff 1 1 lj/cut/omp 0.0 85 ${WCA_bdry_bdry}
pair_coeff 1 1 lj/cut/omp 0.0 85 95.4092741062964

# extra pair potentials

if "${Ori_bdry_attraction}==1" then    "pair_coeff 1 4 morse/omp ${D_morse} ${a_morse} ${r_morse} ${rcut_morse}"

if "${Ori_pair_repulsion}==1" then    "pair_coeff 4 4 harmonic/cut/omp ${epsilon_ori} ${r_ori_equil}"
pair_coeff 4 4 harmonic/cut/omp ${epsilon_ori} ${r_ori_equil}
pair_coeff 4 4 harmonic/cut/omp 0.00532899653979239 ${r_ori_equil}
pair_coeff 4 4 harmonic/cut/omp 0.00532899653979239 1000

